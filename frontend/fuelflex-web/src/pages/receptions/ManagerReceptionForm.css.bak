.reception-form-page{max-width:1120px;margin:0 auto;padding:30px 36px}.reception-form-header{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:24px}.reception-form-header h1{margin:0;color:#0f2747}.reception-form-header p{margin:6px 0;color:#64748b}.reception-form-card{background:#fff;border:1px solid #e5edf5;border-radius:14px;padding:22px;margin-bottom:18px}.reception-form-card h2{font-size:1.05rem;color:#0f2747;margin:0 0 18px}.reception-form-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.reception-form-field{display:grid;gap:6px}.reception-form-field.full{grid-column:1/-1}.reception-form-field label,.reception-form-field span{font-size:.75rem;color:#64748b;font-weight:700}.reception-form-field input,.reception-form-field select,.reception-form-field textarea{width:100%;box-sizing:border-box;border:1px solid #cbd5e1;border-radius:8px;padding:10px 11px;font:inherit;color:#1e293b;background:#fff}.reception-form-field textarea{min-height:78px;resize:vertical}.reception-item{border:1px solid #e2e8f0;border-radius:12px;padding:16px;margin-bottom:14px}.reception-item-head{display:flex;justify-content:space-between;gap:12px;margin-bottom:12px}.reception-item-head h3{margin:0;color:#0f2747;font-size:1rem}.reception-item-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}.reception-metric{background:#f8fafc;border-radius:8px;padding:9px}.reception-metric small{display:block;color:#64748b;font-size:.7rem}.reception-metric strong{display:block;margin-top:4px;color:#1e293b}.reception-line-form{display:grid;grid-template-columns:1fr 1fr 100px;gap:10px}.reception-alert{border-radius:9px;padding:10px 12px;margin-top:10px;font-size:.86rem}.reception-alert.partial{background:#eff6ff;color:#1d4ed8}.reception-alert.over{background:#fff7ed;color:#9a3412}.reception-allocations{margin-top:15px;padding-top:14px;border-top:1px solid #edf2f7}.reception-allocation-row{display:grid;grid-template-columns:1fr 140px;gap:10px;align-items:center;margin-top:8px}.reception-allocation-row label{color:#334155;font-size:.9rem}.reception-form-actions{display:flex;justify-content:flex-end;gap:10px;position:sticky;bottom:0;background:#f8fbfd;padding:14px 0}.reception-submit-modal{position:fixed;inset:0;background:#0f274777;display:grid;place-items:center;z-index:20;padding:20px}.reception-submit-dialog{background:#fff;border-radius:14px;max-width:540px;width:100%;padding:24px;box-shadow:0 20px 50px #0f274744}.reception-submit-dialog h2{margin:0;color:#0f2747}.reception-submit-dialog p{color:#475569;line-height:1.5}.reception-submit-dialog textarea{width:100%;box-sizing:border-box;min-height:90px;border:1px solid #cbd5e1;border-radius:8px;padding:10px;font:inherit}.reception-dialog-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}@media(max-width:760px){.reception-form-page{padding:22px 16px}.reception-form-grid,.reception-metrics{grid-template-columns:1fr 1fr}.reception-line-form{grid-template-columns:1fr}.reception-allocation-row{grid-template-columns:1fr 120px}.reception-form-actions{flex-direction:column}.reception-form-actions button{width:100%;justify-content:center}}